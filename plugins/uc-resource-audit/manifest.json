{
  "manifest_version": 1,
  "id": "com.greencloud.uc.resource-audit",
  "name": "UC 运维工具",
  "version": "0.2.3",
  "description": "查看 UC 资源变更，预览单位改码、改类型和删除的影响",
  "publisher": "greencloud",
  "engines": {
    "host_api": "^1.4"
  },
  "permissions": [
    "host.connections:read",
    "host.data:read"
  ],
  "entrypoints": {
    "ui": {
      "root": "ui",
      "entry": "ui/index.html"
    }
  },
  "contributions": [
    {
      "type": "workbench",
      "id": "com.greencloud.uc.resource-audit.main",
      "label": "UC 资源变更查询"
    },
    {
      "type": "context-menu",
      "id": "com.greencloud.uc.resource-audit.connection",
      "label": "UC 资源变更查询",
      "menu": "connection",
      "action": {
        "type": "open-workbench",
        "workbench": "com.greencloud.uc.resource-audit.main"
      }
    },
    {
      "type": "workbench",
      "id": "com.greencloud.uc.resource-audit.unit-maintenance",
      "label": "UC 单位维护"
    },
    {
      "type": "context-menu",
      "id": "com.greencloud.uc.resource-audit.unit-connection",
      "label": "UC 单位维护",
      "menu": "connection",
      "action": {
        "type": "open-workbench",
        "workbench": "com.greencloud.uc.resource-audit.unit-maintenance"
      }
    }
  ]
}
